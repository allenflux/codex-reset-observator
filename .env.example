# Set real values in the process environment or hosting provider. Never commit secrets.
DATABASE_PATH=var/observatory.sqlite3
SITE_URL=http://localhost:8000
FETCH_LIVE_STATUS=false

# Optional Supabase persistence; empty uses SQLite.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protected API credentials.
CRON_SECRET=
TIBO_WEBHOOK_SECRET=
CODEX_USAGE_MONITOR_SECRET=

# Optional local Codex Usage Monitor.
CODEX_CLI_PATH=
CODEX_USAGE_WEBHOOK_URL=http://127.0.0.1:8000/api/webhook/codex-usage
CODEX_USAGE_POLL_INTERVAL_MS=120000

# Scheduled workflows use this deployed URL, configured in GitHub secrets.
APP_URL=

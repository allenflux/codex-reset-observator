# Set real values in the process environment or hosting provider. Never commit secrets.
COLLECTION_BACKEND=mysql
MYSQL_HOST=
# Use the database server's published TCP port; this deployment uses 32768.
MYSQL_PORT=32768
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Optional CA certificate path for verified MySQL TLS.
MYSQL_SSL_CA=

# The separate collector runs on startup, then at this interval (minimum 300).
COLLECTION_INTERVAL_SECONDS=3600
# Mirror the original site's curated public social card; no X key or LLM required.
SOCIAL_COLLECTION_ENABLED=true
SOCIAL_COLLECTION_INTERVAL_SECONDS=300
# Local training/export output; ignored by Git and never promoted automatically.
COLLECTION_OUTPUT_DIR=var/training

# Docker Compose listens on all host interfaces at this port.
PORT=9090
# Optional public URL override; leave blank to use the incoming request origin.
SITE_URL=
# Public OpenAI Status API; no key is needed.
FETCH_LIVE_STATUS=true

# Legacy local/testing storage; unused by the MySQL deployment above.
DATABASE_PATH=var/observatory.sqlite3
COLLECTION_SQLITE_PATH=var/collection.sqlite3
# Optional legacy Supabase adapter; leave empty for MySQL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protected API credentials.
CRON_SECRET=
TIBO_WEBHOOK_SECRET=
CODEX_USAGE_MONITOR_SECRET=

# Optional local Codex Usage Monitor.
CODEX_CLI_PATH=
CODEX_USAGE_WEBHOOK_URL=http://127.0.0.1:8000/api/webhook/codex-usage
CODEX_USAGE_POLL_INTERVAL_MS=120000

# Scheduled workflows use this deployed URL, configured in GitHub secrets.
APP_URL=
